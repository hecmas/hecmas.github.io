---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CircuitLauncher from '../components/CircuitLauncher.astro';
import { profile } from '../data/site';
import { ctf } from '../data/ctf';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: { published: Date; tags?: string[] };
  noindex?: boolean;
}

const { title, description = profile.description, image = '/avatar.png', article, noindex = false } = Astro.props;
const sourceComment = `<!--\n  Hello, fellow CTF player. Not every signal here is constrained.\n  share₁ = 0x${ctf.share1}\n  share₂ is printed where developers look. Combine them; ⊕ is your friend.\n-->`;
const fullTitle = title ? `${title} · ${profile.shortName}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <Fragment set:html={sourceComment} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}: Writing`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f8f7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0d10" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? profile.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@EllipticHector" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}

    <!-- Apply the saved theme before first paint to avoid a flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CircuitLauncher />
    <script is:inline define:vars={{ share2: ctf.share2 }}>
      console.log(
        '%c🐒 Hello, fellow CTF player.%c\nNot every signal here is constrained.\n\nshare₂ = 0x' +
          share2 +
          '\n\nshare₁ is somewhere in the page source. ⊕ them.',
        'font: 600 14px ui-monospace, monospace; color: #c9961f',
        'font: 12px ui-monospace, monospace',
      );
    </script>
  </body>
</html>
